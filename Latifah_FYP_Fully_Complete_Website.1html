<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Nur Latifah Humairah — Complete FYP Website</title>
<meta name="description" content="Complete Industrial Design FYP research website by Nur Latifah Humairah Binti Dzulkifly.">
<script type="text/javascript" src="https://gc.kis.v2.scr.kaspersky-labs.com/FD126C42-EBFA-4E12-B309-BB3FDD723AC1/main.js?attr=tD7W3BbCmSRwQS_hVOalfu28csceJCwMFm6rXLGM9Ii6NbBQqDPFZeziPu3UReFCCoi5VleSGewxvn10i5NwbrPfU8PxjrPvopJsjXB1y3GWlkoAy6CsF7nIiyxkk_F3hCBeWu4IRYWJGIqGFZpVD4zqGDd4L0yg7DgqFDo4O3JUCLaNfNjQ3fTQJzDNTl1szAeVqOzI2eJq_10PZQ4VPH2xWd3abbZM5qxl2F4Lwlf722LlsGzw30dkpv_hheV-3P0yEpIxatad-47jvA1hqxMTYhzZCkAqfVq4zz1i2HHraoCHNiOBTAEwJ03oTPrn7CIlzIxL5jX6y7lbHPbswc786DVsOhsQdW500Ou_LdQ" charset="UTF-8"></script><style>
:root{
  --green:#06382c;
  --deep:#031f19;
  --forest:#0f4a3a;
  --sage:#a9beb6;
  --sage2:#dfe9e4;
  --cream:#f7f5ee;
  --paper:#fffefa;
  --ink:#171d19;
  --muted:#5f6863;
  --accent:#91ad50;
  --gold:#d5a33b;
  --orange:#e7893c;
  --line:rgba(23,29,25,.13);
  --shadow:0 22px 65px rgba(3,39,31,.14);
  --r:26px;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;background:var(--paper);font-family:"Avenir Next","Segoe UI",Arial,sans-serif;color:var(--ink);line-height:1.65}
img{display:block;width:100%;height:auto}
a{text-decoration:none;color:inherit}
button{font:inherit}
.container{width:min(1180px,calc(100% - 40px));margin:auto}
.section{padding:100px 0;scroll-margin-top:84px}
.section.soft{background:var(--cream)}
.section.dark{background:var(--deep);color:white}
.eyebrow{font-size:.73rem;letter-spacing:.18em;text-transform:uppercase;font-weight:900;color:var(--accent)}
.title{font-size:clamp(2.7rem,6vw,6.2rem);line-height:.94;letter-spacing:-.06em;margin:12px 0 24px;font-weight:520;max-width:1050px}
.subtitle{font-size:clamp(1.8rem,3.5vw,3.2rem);line-height:1.05;letter-spacing:-.04em;margin:10px 0 18px}
.lead{max-width:800px;font-size:1.1rem;color:var(--muted);margin:0}
.dark .lead{color:rgba(255,255,255,.73)}
.nav{position:fixed;inset:0 0 auto;z-index:60;background:rgba(255,254,250,.94);backdrop-filter:blur(18px);border-bottom:1px solid var(--line)}
.nav-inner{height:78px;display:flex;align-items:center;justify-content:space-between;gap:22px}
.brand{font-size:1.1rem;font-weight:950;letter-spacing:-.03em}.brand span{color:var(--accent)}
.nav-links{display:flex;gap:20px;align-items:center;font-size:.81rem;font-weight:800}
.nav-links a{position:relative}.nav-links a:after{content:"";position:absolute;left:0;right:100%;bottom:-8px;height:2px;background:var(--accent);transition:.25s}.nav-links a:hover:after{right:0}
.menu{display:none;border:0;background:transparent;font-size:1.55rem;cursor:pointer}
.hero{min-height:100vh;display:flex;align-items:flex-end;position:relative;color:white;background-size:cover;background-position:center;padding:148px 0 86px}
.hero:before{content:"";position:absolute;inset:0;background:linear-gradient(90deg,rgba(0,0,0,.82) 0%,rgba(0,0,0,.57) 46%,rgba(0,0,0,.1) 80%),linear-gradient(0deg,rgba(3,31,25,.68),transparent 55%)}
.hero-content{position:relative;z-index:2;max-width:860px}
.hero h1{font-size:clamp(3.9rem,8.6vw,8.6rem);line-height:.84;letter-spacing:-.075em;margin:18px 0 28px;font-weight:520}
.hero h1 strong{display:block;color:#b3cf70}
.hero p{max-width:690px;font-size:1.1rem;color:rgba(255,255,255,.85)}
.buttons{display:flex;gap:12px;flex-wrap:wrap;margin-top:30px}
.btn{display:inline-flex;align-items:center;justify-content:center;min-height:52px;padding:0 24px;border-radius:999px;font-size:.86rem;font-weight:850;border:1px solid white}
.btn.primary{background:white;color:var(--green)}
.btn.secondary{background:rgba(255,255,255,.08);color:white}
.glance{position:relative;z-index:5;margin-top:-44px}
.glance-grid{display:grid;grid-template-columns:repeat(4,1fr);background:white;box-shadow:var(--shadow);border-radius:24px;overflow:hidden}
.glance-card{padding:28px;border-right:1px solid var(--line)}
.glance-card:last-child{border-right:0}
.glance-card small{display:block;text-transform:uppercase;letter-spacing:.14em;color:var(--accent);font-weight:900}
.glance-card strong{display:block;margin-top:7px;font-size:.96rem}
.two{display:grid;grid-template-columns:.85fr 1.15fr;gap:64px;align-items:start}
.three{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
.four{display:grid;grid-template-columns:repeat(4,1fr);gap:15px}
.card{background:white;border:1px solid var(--line);border-radius:var(--r);padding:28px;box-shadow:0 12px 40px rgba(3,39,31,.055)}
.card h3{margin:0 0 9px;font-size:1.15rem}
.card p{margin:0;color:var(--muted);font-size:.93rem}
.dark .card{background:rgba(255,255,255,.06);border-color:rgba(255,255,255,.14);box-shadow:none}
.dark .card p{color:rgba(255,255,255,.7)}
.big-question{font-size:clamp(2.2rem,5vw,4.9rem);line-height:1.04;letter-spacing:-.055em;font-weight:520;margin:0}
.big-question em{font-style:normal;color:var(--accent)}
.problem-strip{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:45px}
.problem{border-top:1px solid var(--line);padding:22px 0}
.problem b{display:block;font-size:2.4rem;color:var(--accent)}
.problem h3{font-size:1.12rem;margin:10px 0 7px}
.problem p{margin:0;color:var(--muted);font-size:.92rem}
.pill-grid{display:grid;grid-template-columns:repeat(6,1fr);gap:11px;margin-top:30px}
.pill{background:var(--sage2);border-radius:18px;padding:18px;min-height:120px}
.pill span{display:block;font-size:.67rem;text-transform:uppercase;letter-spacing:.13em;font-weight:900;color:var(--forest)}
.pill p{margin:8px 0 0;color:var(--muted);font-size:.84rem;line-height:1.45}
.objectives{margin-top:42px}
.objective strong{font-size:2.3rem;color:var(--accent)}
.objective h3{margin:10px 0 8px}
.scope-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:18px;margin-top:38px}
.scope{background:var(--sage2);border-radius:22px;padding:26px}
.scope h3{margin:0 0 12px}
.scope ul{margin:0;padding-left:18px;color:var(--muted);font-size:.91rem}
.contribution{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:32px}
.contribution article{background:#154b3d;border-radius:22px;padding:25px}
.contribution b{color:#b9d274;font-size:.78rem;letter-spacing:.12em;text-transform:uppercase}
.contribution h3{margin:10px 0 8px}
.contribution p{margin:0;color:rgba(255,255,255,.7);font-size:.9rem}
.lit-grid{display:grid;grid-template-columns:.76fr 1.24fr;gap:65px}
.lit-lines{display:grid}
.lit-item{display:grid;grid-template-columns:48px 1fr;gap:18px;padding:21px 0;border-top:1px solid var(--line)}
.lit-item b{color:var(--accent)}
.lit-item h3{font-size:1.05rem;margin:0 0 5px}
.lit-item p{margin:0;color:var(--muted);font-size:.91rem}
.pestle{display:grid;grid-template-columns:repeat(3,1fr);gap:15px;margin-top:46px}
.pest{background:var(--cream);border-radius:22px;padding:24px}
.pest small{font-weight:900;letter-spacing:.13em;color:var(--accent)}
.pest h3{margin:11px 0 8px}
.pest p{font-size:.88rem;color:var(--muted);margin:0}
.sdg{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:42px}
.sdg-card{border-radius:23px;padding:26px;min-height:260px;display:flex;flex-direction:column;justify-content:space-between}
.sdg-card strong{font-size:4.8rem;line-height:1;opacity:.25}
.sdg-card h3{margin:0;font-size:1.22rem;line-height:1.16}
.sdg-card p{margin:9px 0 0;font-size:.9rem}
.s11{background:#f2ad45}.s12{background:#c99c31}.s13{background:#4b8747;color:white}
.methods{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-top:40px}
.method{background:#164a3b;border-radius:22px;padding:24px;min-height:215px}
.method small{color:#b9d274;text-transform:uppercase;letter-spacing:.13em;font-weight:900}
.method h3{margin:12px 0 8px}.method p{margin:0;color:rgba(255,255,255,.7);font-size:.88rem}
.process{display:grid;grid-template-columns:repeat(5,1fr);gap:10px;margin-top:34px}
.step{position:relative;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.13);border-radius:19px;padding:20px}
.step b{color:#b9d274}.step h4{margin:9px 0 5px}.step p{margin:0;color:rgba(255,255,255,.65);font-size:.82rem}
.data-tabs{display:grid;gap:16px;margin-top:42px}
details.data{border:1px solid var(--line);border-radius:22px;background:white;overflow:hidden}
details.data summary{cursor:pointer;list-style:none;padding:24px 28px;font-size:1.1rem;font-weight:800;display:flex;justify-content:space-between;align-items:center}
details.data summary::-webkit-details-marker{display:none}
details.data summary:after{content:"+";font-size:1.6rem;color:var(--accent)}
details.data[open] summary:after{content:"−"}
.data-body{padding:0 28px 28px;border-top:1px solid var(--line)}
.finding-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:22px}
.finding{background:var(--cream);border-radius:18px;padding:20px}
.finding strong{display:block;font-size:1.75rem;color:var(--forest)}
.finding h4{margin:7px 0 5px;font-size:.96rem}.finding p{font-size:.84rem;color:var(--muted);margin:0}
.respondents{display:grid;grid-template-columns:.65fr 1.35fr;gap:24px;margin-top:42px}
.total{background:var(--green);color:white;border-radius:25px;padding:30px;display:flex;flex-direction:column;justify-content:flex-end;min-height:315px}
.total strong{font-size:6.8rem;line-height:.78;letter-spacing:-.08em;color:#b8d272}
.total span{max-width:180px;margin-top:22px;color:rgba(255,255,255,.72)}
.stat-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:13px}
.stat{background:white;border:1px solid var(--line);border-radius:20px;padding:20px}
.stat strong{display:block;font-size:1.9rem;color:var(--green)}
.stat span{display:block;font-size:.82rem;color:var(--muted);min-height:38px}
.bar{height:6px;background:#e4ece7;border-radius:999px;overflow:hidden;margin-top:12px}.bar i{display:block;height:100%;background:var(--accent)}
.synthesis{display:grid;grid-template-columns:repeat(2,1fr);gap:16px;margin-top:40px}
.theme{background:var(--cream);border-radius:22px;padding:25px}.theme h3{margin:0 0 8px}.theme p{margin:0;color:var(--muted);font-size:.91rem}
.priority{display:grid;gap:10px;margin-top:34px}
.priority-row{display:grid;grid-template-columns:120px 1fr 1.2fr;gap:14px;align-items:center;background:white;border:1px solid var(--line);border-radius:17px;padding:16px 18px}
.priority-label{font-size:.72rem;letter-spacing:.1em;text-transform:uppercase;font-weight:900}
.high{color:#a94232}.mhigh{color:#c9772d}.medium{color:#927d2b}.low{color:#4e7d65}
.trace-table,.matrix{overflow-x:auto;margin-top:32px}
table{width:100%;border-collapse:collapse;background:white;border-radius:20px;overflow:hidden;border:1px solid var(--line)}
th,td{text-align:left;padding:15px 16px;border-bottom:1px solid var(--line);font-size:.88rem}
th{background:var(--green);color:white}
tr:last-child td{border-bottom:0}
td.score{text-align:center;font-weight:850}
td.best{background:#edf4da;color:#506d18}
.concepts{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:42px}
.concept{background:var(--cream);border-radius:24px;padding:27px;display:flex;flex-direction:column}
.concept-top{display:flex;justify-content:space-between}.concept-top span{font-size:.7rem;text-transform:uppercase;letter-spacing:.13em;font-weight:900;color:var(--accent)}.concept-top strong{font-size:2.4rem;color:var(--green)}
.concept h3{font-size:1.28rem;line-height:1.13;margin:20px 0 10px}
.concept p,.concept li{font-size:.88rem;color:var(--muted)}
.concept ul{padding-left:18px}.badge{margin-top:auto;border-top:1px solid var(--line);padding-top:15px;font-size:.7rem;text-transform:uppercase;letter-spacing:.1em;font-weight:900;color:var(--green)}
.rubric{display:grid;grid-template-columns:repeat(5,1fr);gap:11px;margin-top:28px}
.rubric div{background:var(--sage2);border-radius:17px;padding:18px}.rubric strong{font-size:1.75rem;color:var(--forest)}.rubric span{display:block;font-size:.78rem;color:var(--muted)}
.calc{margin-top:18px;background:var(--green);color:white;border-radius:18px;padding:20px 24px;font-weight:750}
.score-why{display:grid;gap:12px;margin-top:25px}
.score-why details{background:white;border:1px solid var(--line);border-radius:17px;padding:0 20px}
.score-why summary{cursor:pointer;font-weight:800;padding:18px 0}
.score-why p{font-size:.9rem;color:var(--muted)}
.selection{display:grid;grid-template-columns:.8fr 1.2fr;gap:25px;background:var(--sage2);border-radius:25px;padding:30px;margin-top:35px}
.selection h3{font-size:1.5rem;line-height:1.2;margin:10px 0 0}.selection p{margin:0;color:var(--muted)}
.merge{display:grid;grid-template-columns:repeat(3,1fr);gap:13px;margin-top:22px}
.merge-card{background:white;border-radius:18px;padding:20px;border:1px solid var(--line)}
.merge-card b{color:var(--accent)}.merge-card h4{margin:8px 0 4px}.merge-card p{font-size:.84rem;color:var(--muted);margin:0}
.final-grid{display:grid;grid-template-columns:1.08fr .92fr;gap:50px;align-items:start;margin-top:68px}
.final-visual{border-radius:27px;overflow:hidden;box-shadow:var(--shadow)}
.final-copy{position:sticky;top:108px}
.final-copy h3{font-size:clamp(2.1rem,4vw,4.1rem);line-height:1;letter-spacing:-.05em;margin:10px 0 20px;font-weight:520}
.features{display:grid;margin-top:22px}
.feature{display:grid;grid-template-columns:42px 1fr;gap:14px;padding:14px 0;border-top:1px solid var(--line)}
.feature b{width:38px;height:38px;border-radius:50%;display:grid;place-items:center;background:var(--accent);font-size:.74rem}
.feature h4{margin:0 0 3px;font-size:.96rem}.feature p{margin:0;color:var(--muted);font-size:.85rem}
.scenario-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-top:28px}
.scenario{background:var(--cream);border-radius:20px;padding:22px}
.scenario b{display:block;color:var(--accent);font-size:.75rem;text-transform:uppercase;letter-spacing:.12em}
.scenario h4{margin:10px 0 5px}.scenario p{margin:0;color:var(--muted);font-size:.86rem}
.story{margin-top:34px;border-radius:27px;overflow:hidden;box-shadow:var(--shadow)}
.achievement{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:38px}
.achieve{background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.14);border-radius:21px;padding:24px}
.achieve span{display:inline-block;background:#b3ce72;color:var(--deep);border-radius:999px;padding:5px 10px;font-size:.7rem;font-weight:900}
.achieve h3{margin:15px 0 8px}.achieve p{margin:0;color:rgba(255,255,255,.68);font-size:.9rem}
.profile-grid{display:grid;grid-template-columns:.78fr 1.22fr;gap:54px;align-items:center}
.profile{border-radius:28px;overflow:hidden}.profile img{height:680px;object-fit:cover}
.tags{display:flex;flex-wrap:wrap;gap:8px;margin-top:22px}.tag{border:1px solid rgba(255,255,255,.22);border-radius:999px;padding:8px 13px;font-size:.78rem;color:rgba(255,255,255,.75)}
.projects{display:grid;gap:24px;margin-top:70px}
.project{display:grid;grid-template-columns:1fr 1fr;background:white;color:var(--ink);border-radius:28px;overflow:hidden}
.project:nth-child(even) .project-img{order:2}
.project-img{min-height:480px}.project-img img{height:100%;object-fit:cover}
.project-copy{padding:45px;display:flex;flex-direction:column;justify-content:center}
.project-copy small{color:var(--accent);font-weight:900;letter-spacing:.13em;text-transform:uppercase}
.project-copy h3{font-size:clamp(2rem,4vw,3.7rem);line-height:1;letter-spacing:-.05em;font-weight:520;margin:15px 0 18px}
.project-copy p{color:var(--muted)}
.references{columns:2;column-gap:45px;margin-top:32px}
.references li{break-inside:avoid;margin-bottom:12px;color:var(--muted);font-size:.88rem}
.contact-box{background:var(--green);color:white;border-radius:26px;padding:34px;display:flex;justify-content:space-between;align-items:center;gap:25px}
.contact-box h3{font-size:2rem;margin:0}.contact-box p{margin:6px 0 0;color:rgba(255,255,255,.7)}
.footer{background:#021610;color:white;padding:42px 0}.footer-inner{display:flex;justify-content:space-between;align-items:center;gap:20px}.footer p{margin:0;color:rgba(255,255,255,.58)}
.backtop{position:fixed;right:20px;bottom:20px;width:52px;height:52px;background:black;color:white;display:grid;place-items:center;z-index:55}
.reveal{opacity:0;transform:translateY(20px);transition:.65s ease}.reveal.show{opacity:1;transform:none}

@media(max-width:1020px){
 .nav-links{display:none;position:absolute;top:78px;left:0;right:0;background:var(--paper);padding:22px;flex-direction:column;align-items:flex-start;border-bottom:1px solid var(--line)}
 .nav-links.open{display:flex}.menu{display:block}
 .glance-grid{grid-template-columns:repeat(2,1fr)}
 .glance-card:nth-child(2){border-right:0}
 .two,.lit-grid,.respondents,.selection,.final-grid,.profile-grid,.project{grid-template-columns:1fr}
 .three,.concepts,.contribution,.achievement{grid-template-columns:1fr}
 .four,.methods,.process,.sdg,.pestle,.scenario-grid{grid-template-columns:repeat(2,1fr)}
 .pill-grid{grid-template-columns:repeat(3,1fr)}
 .stat-grid{grid-template-columns:repeat(2,1fr)}
 .project:nth-child(even) .project-img{order:0}
 .final-copy{position:relative;top:auto}
}
@media(max-width:650px){
 .container{width:min(100% - 28px,1180px)}.section{padding:76px 0}
 .hero{min-height:850px;background-position:62% center;padding-top:120px}.hero h1{font-size:3.7rem}
 .glance{margin-top:-28px}.glance-grid{grid-template-columns:1fr}.glance-card{border-right:0;border-bottom:1px solid var(--line)}
 .problem-strip,.scope-grid,.synthesis,.four,.methods,.process,.sdg,.pestle,.scenario-grid,.stat-grid,.rubric,.merge{grid-template-columns:1fr}
 .pill-grid{grid-template-columns:repeat(2,1fr)}
 .priority-row{grid-template-columns:1fr}
 .finding-grid{grid-template-columns:1fr}
 .total strong{font-size:5.2rem}.profile img{height:560px}.project-img{min-height:420px}.project-copy{padding:30px 24px}
 .references{columns:1}.contact-box,.footer-inner{flex-direction:column;align-items:flex-start}
}
</style>
</head>
<body>

<header class="nav">
  <div class="container nav-inner">
    <a class="brand" href="#home">LATIFAH <span>STUDIO</span></a>
    <button class="menu" aria-label="Open menu">☰</button>
    <nav class="nav-links">
      <a href="#home">Home</a>
      <a href="#study">Study</a>
      <a href="#literature">Literature</a>
      <a href="#method">Method</a>
      <a href="#data">Data</a>
      <a href="#synthesis">Synthesis</a>
      <a href="#concept">Concept</a>
      <a href="#outcome">Outcome</a>
      <a href="#about-me">About Me</a>
    </nav>
  </div>
</header>

<main>
<section class="hero" id="home" style="background-image:url('data:image/webp;base64,')">
  <div class="container">
    <div class="hero-content reveal">
      <div class="eyebrow">IDD550 Degree Project 1</div>
      <h1>Exploring <strong>Participatory Design</strong> Approaches</h1>
      <p>In developing environmentally responsible community products at Taman Botani Negara Shah Alam.</p>
      <div class="buttons">
        <a class="btn primary" href="#study">Begin the Research Story →</a>
        <a class="btn secondary" href="#concept">View Final Concept</a>
      </div>
    </div>
  </div>
</section>

<div class="glance">
  <div class="container">
    <div class="glance-grid">
      <div class="glance-card"><small>Case Study</small><strong>Taman Botani Negara Shah Alam</strong></div>
      <div class="glance-card"><small>Research Design</small><strong>Mixed-Method Research</strong></div>
      <div class="glance-card"><small>Participants</small><strong>6 Interviews + 23 Questionnaires</strong></div>
      <div class="glance-card"><small>Final Outcome</small><strong>Eco-Interactive Mobility Rest Hub</strong></div>
    </div>
  </div>
</div>

<section class="section">
  <div class="container">
    <div class="two">
      <div class="reveal">
        <div class="eyebrow">Let Us Begin</div>
        <h2 class="big-question">How can a botanical park become more <em>comfortable, interactive and community-centred?</em></h2>
      </div>
      <div class="reveal">
        <p class="lead">Taman Botani Negara Shah Alam is valued for its natural environment, recreation and learning opportunities. However, visitor evidence shows issues involving fatigue, steep routes, limited tram seating, passive information, underused facilities and inconsistent maintenance.</p>
        <p class="lead" style="margin-top:18px"><strong>My goal:</strong> translate real visitor needs into an environmentally responsible product that supports resting, movement, social interaction, nature learning and simple public participation.</p>
      </div>
    </div>
    <div class="problem-strip">
      <article class="problem reveal"><b>01</b><h3>Comfort & Mobility</h3><p>Long routes and waiting activities can cause tiredness, discomfort and informal resting along pathways.</p></article>
      <article class="problem reveal"><b>02</b><h3>Passive Experience</h3><p>Many signs and facilities provide basic functions but limited interaction, learning and engagement.</p></article>
      <article class="problem reveal"><b>03</b><h3>Sustainability & Participation</h3><p>Visitors prefer durable products and accessible ways to contribute feedback and ideas.</p></article>
    </div>
  </div>
</section>

<section class="section dark" id="study">
  <div class="container">
    <div class="eyebrow reveal">01 — About the Study</div>
    <h2 class="title reveal">The context, problem and research direction.</h2>
    <div class="two">
      <div class="reveal">
        <h3 class="subtitle">Background of TBNSA</h3>
        <p class="lead">Taman Botani Negara Shah Alam is a national botanical garden in Shah Alam, Selangor. Covering approximately 817 hectares, it provides habitats for flora and fauna and serves as an important recreational destination in the Klang Valley.</p>
      </div>
      <div class="reveal">
        <h3 class="subtitle">Research Problem</h3>
        <p class="lead">Visitor and community involvement in the development of public-use products remains limited. User experiences and environmental expectations may not be fully translated into product development, while existing facilities present opportunities for more sustainable, interactive and user-centred improvements.</p>
      </div>
    </div>

    <div class="pill-grid">
      <div class="pill reveal"><span>What</span><p>Explore user needs, behaviours and preferences for sustainable community products.</p></div>
      <div class="pill reveal"><span>Why</span><p>Improve relevance, usability, environmental responsibility and user involvement.</p></div>
      <div class="pill reveal"><span>Who</span><p>Visitors, students, families, cyclists, joggers and local community users.</p></div>
      <div class="pill reveal"><span>Where</span><p>Taman Botani Negara Shah Alam, Selangor, Malaysia.</p></div>
      <div class="pill reveal"><span>When</span><p>During normal park use, including weekdays, weekends and leisure hours.</p></div>
      <div class="pill reveal"><span>How</span><p>Observation, online interviews, questionnaire surveys and document analysis.</p></div>
    </div>

    <div class="three objectives">
      <article class="card objective reveal"><strong>RO1</strong><h3>Identify</h3><p>Suitable participatory design methods for engaging the local community in product development.</p></article>
      <article class="card objective reveal"><strong>RO2</strong><h3>Analyse</h3><p>Selected park facilities, user needs, existing issues and opportunities for environmentally responsible improvements.</p></article>
      <article class="card objective reveal"><strong>RO3</strong><h3>Develop</h3><p>A community-centred and environmentally responsible concept that promotes sustainable behaviour.</p></article>
    </div>

    <div class="scope-grid">
      <article class="scope reveal"><h3>Scope of Study</h3><ul><li>Location: TBNSA.</li><li>Users: selected visitors, community members and stakeholders.</li><li>Facilities: transportation, gazebos, rest areas, information and recreational spaces.</li><li>Outcome: a research-supported community product concept.</li></ul></article>
      <article class="scope reveal"><h3>Limitations</h3><ul><li>Limited sample size.</li><li>Research time constraint.</li><li>Possible respondent bias.</li><li>The project does not include full prototype production or physical testing.</li></ul></article>
    </div>

    <div class="contribution">
      <article class="reveal"><b>Academic</b><h3>Knowledge Contribution</h3><p>Strengthens understanding of participatory and user-centred design in public green spaces.</p></article>
      <article class="reveal"><b>Practical</b><h3>Design Contribution</h3><p>Supports more relevant, usable and community-centred facilities at TBNSA.</p></article>
      <article class="reveal"><b>Environmental & Social</b><h3>Community Contribution</h3><p>Encourages environmental awareness, sustainable behaviour and active participation.</p></article>
    </div>
  </div>
</section>

<section class="section" id="literature">
  <div class="container">
    <div class="lit-grid">
      <div class="reveal">
        <div class="eyebrow">02 — Literature Review</div>
        <h2 class="title">Evidence that defines the design lens.</h2>
        <p class="lead">The review connects participatory design, public green-space quality, environmental responsibility, technology and universal access.</p>
      </div>
      <div class="lit-lines">
        <article class="lit-item reveal"><b>01</b><div><h3>Participatory Design</h3><p>Visitor input should influence design criteria and final decisions, rather than remain as general consultation.</p></div></article>
        <article class="lit-item reveal"><b>02</b><div><h3>Public Green Space</h3><p>Comfort, safety, accessibility, social interaction, greenery and maintenance shape park quality.</p></div></article>
        <article class="lit-item reveal"><b>03</b><div><h3>Environmental Responsibility</h3><p>Durable, repairable, low-impact and easy-maintenance products support longer service life and reduced waste.</p></div></article>
        <article class="lit-item reveal"><b>04</b><div><h3>Technology & Participation</h3><p>Simple optional tools such as QR information and digital feedback can improve access without excluding users.</p></div></article>
        <article class="lit-item reveal"><b>05</b><div><h3>Universal Access</h3><p>Seating, circulation, signage and facility placement should consider users of different ages and abilities.</p></div></article>
      </div>
    </div>

    <div class="pestle">
      <article class="pest reveal"><small>Political</small><h3>Public Participation</h3><p>Translate visitor feedback into actual criteria and support collaboration between users, designers and management.</p></article>
      <article class="pest reveal"><small>Economic</small><h3>Lifecycle Value</h3><p>Use durable, affordable, modular and repairable components to reduce long-term maintenance cost.</p></article>
      <article class="pest reveal"><small>Social</small><h3>Shared Park Use</h3><p>Provide comfortable and flexible facilities for individual, group and recreational activities.</p></article>
      <article class="pest reveal"><small>Technological</small><h3>Simple Digital Tools</h3><p>Apply optional QR information, digital maps and feedback without creating complicated systems.</p></article>
      <article class="pest reveal"><small>Legal</small><h3>Safety & Accessibility</h3><p>Consider suitable heights, safe circulation, clear pathways, signage and local-authority requirements.</p></article>
      <article class="pest reveal"><small>Environmental</small><h3>Low-Impact Design</h3><p>Protect vegetation, biodiversity, shade and water flow through durable and resilient design decisions.</p></article>
    </div>

    <div class="sdg">
      <article class="sdg-card s11 reveal"><strong>11</strong><div><h3>Sustainable Cities & Communities</h3><p>Inclusive, accessible and socially supportive public spaces.</p></div></article>
      <article class="sdg-card s12 reveal"><strong>12</strong><div><h3>Responsible Consumption & Production</h3><p>Durable products, responsible materials and reduced resource waste.</p></div></article>
      <article class="sdg-card s13 reveal"><strong>13</strong><div><h3>Climate Action</h3><p>Low-impact materials, shade and environmental awareness.</p></div></article>
    </div>
  </div>
</section>

<section class="section dark" id="method">
  <div class="container">
    <div class="eyebrow reveal">03 — Research Methodology</div>
    <h2 class="title reveal">A mixed-method approach.</h2>
    <p class="lead reveal">Four methods were combined so that facility evidence, user experiences, preferences and design requirements could be compared through triangulation.</p>
    <div class="methods">
      <article class="method reveal"><small>Method 01</small><h3>Observation</h3><p>Selected facilities, visitor behaviour, activities, comfort, accessibility and design issues.</p></article>
      <article class="method reveal"><small>Method 02</small><h3>Online Structured Interviews</h3><p>Six park users shared experiences, needs, preferred participation methods and desired product features.</p></article>
      <article class="method reveal"><small>Method 03</small><h3>Questionnaire Survey</h3><p>Twenty-three valid responses measured facility usage, satisfaction, participation and sustainability preferences.</p></article>
      <article class="method reveal"><small>Method 04</small><h3>Document Analysis</h3><p>Academic research, government guidelines, accessibility standards and design precedents.</p></article>
    </div>
    <div class="process">
      <article class="step reveal"><b>01</b><h4>Define</h4><p>Research problem, objectives, questions and scope.</p></article>
      <article class="step reveal"><b>02</b><h4>Review</h4><p>Literature, regulations, precedent and sustainability criteria.</p></article>
      <article class="step reveal"><b>03</b><h4>Collect</h4><p>Observation, interview and questionnaire evidence.</p></article>
      <article class="step reveal"><b>04</b><h4>Synthesise</h4><p>Compare findings and translate themes into criteria.</p></article>
      <article class="step reveal"><b>05</b><h4>Develop</h4><p>Create, evaluate and select the final concept direction.</p></article>
    </div>
  </div>
</section>

<section class="section soft" id="data">
  <div class="container">
    <div class="eyebrow reveal">04 — Data Collection & Analysis</div>
    <h2 class="title reveal">What visitors and facilities reveal.</h2>
    <p class="lead reveal">Detailed findings are organised by method. Expand each section to view the evidence and design implications.</p>

    <div class="data-tabs">
      <details class="data reveal" open>
        <summary>Observation Findings</summary>
        <div class="data-body">
          <p class="lead">Observation covered transportation, waiting and resting, recreational attractions, nature and environmental areas, and information facilities.</p>
          <div class="finding-grid">
            <article class="finding"><strong>Transport</strong><h4>Mobility & Safety</h4><p>Trams, bicycles and scooters support movement, but limited seats, waiting time, steep routes and fatigue create discomfort and safety issues.</p></article>
            <article class="finding"><strong>Resting</strong><h4>Comfort & Maintenance</h4><p>Shelters, gazebos and seating support resting and socialising, but some were old, empty or poorly maintained.</p></article>
            <article class="finding"><strong>Recreation</strong><h4>Underused Attractions</h4><p>Some gardens, lake areas and viewing facilities were quiet, showing a need for more interaction and promotion.</p></article>
            <article class="finding"><strong>Nature</strong><h4>Strong Environmental Value</h4><p>Greenery and lake areas provide relaxation and learning potential, but educational features remain mostly passive.</p></article>
            <article class="finding"><strong>Information</strong><h4>Static Communication</h4><p>Maps, plant labels and signs are useful but basic, creating an opportunity for more interactive information.</p></article>
            <article class="finding"><strong>Design Need</strong><h4>Strategic Rest Support</h4><p>Visitors need safe, shaded and accessible rest points along walking and cycling routes.</p></article>
          </div>
        </div>
      </details>

      <details class="data reveal">
        <summary>Interview Findings — 6 Park Users</summary>
        <div class="data-body">
          <div class="finding-grid">
            <article class="finding"><strong>66.7%</strong><h4>Female Respondents</h4><p>The interview sample mainly reflects female young-adult perspectives.</p></article>
            <article class="finding"><strong>83.3%</strong><h4>Aged 18–25</h4><p>Most participants were educated young adults.</p></article>
            <article class="finding"><strong>83.3%</strong><h4>Rare Visitors</h4><p>Most respondents visited occasionally, indicating opportunities to improve attraction and repeat use.</p></article>
            <article class="finding"><strong>100%</strong><h4>Liked the Environment</h4><p>The natural setting is TBNSA’s strongest attraction.</p></article>
            <article class="finding"><strong>66.7%</strong><h4>Limited Interactive Products</h4><p>The main weakness was a lack of interactive park facilities.</p></article>
            <article class="finding"><strong>83.3%</strong><h4>Eco-Friendly Recreation</h4><p>Respondents wanted sustainable recreational products.</p></article>
            <article class="finding"><strong>66.7%</strong><h4>Digital Surveys & Platforms</h4><p>Accessible online methods were preferred for public feedback.</p></article>
            <article class="finding"><strong>66.7%</strong><h4>Lack of Time</h4><p>The main participation barrier means engagement should be simple and flexible.</p></article>
            <article class="finding"><strong>83.3%</strong><h4>Sustainable Materials</h4><p>Recycled or sustainable materials were strongly supported.</p></article>
          </div>
        </div>
      </details>

      <details class="data reveal">
        <summary>Questionnaire Respondent Profile — 23 Valid Responses</summary>
        <div class="data-body">
          <div class="respondents">
            <div class="total"><strong>23</strong><span>valid questionnaire responses</span></div>
            <div class="stat-grid">
              <article class="stat"><strong>56.5%</strong><span>Female respondents</span><div class="bar"><i style="width:56.5%"></i></div></article>
              <article class="stat"><strong>69.6%</strong><span>Aged 18–25 years old</span><div class="bar"><i style="width:69.6%"></i></div></article>
              <article class="stat"><strong>82.6%</strong><span>Single respondents</span><div class="bar"><i style="width:82.6%"></i></div></article>
              <article class="stat"><strong>82.6%</strong><span>Without children</span><div class="bar"><i style="width:82.6%"></i></div></article>
