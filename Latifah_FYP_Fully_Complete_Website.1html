              <article class="stat"><strong>63.6%</strong><span>Degree-level education</span><div class="bar"><i style="width:63.6%"></i></div></article>
              <article class="stat"><strong>87%</strong><span>Rarely visit the park</span><div class="bar"><i style="width:87%"></i></div></article>
              <article class="stat"><strong>69.6%</strong><span>Visit for relaxation</span><div class="bar"><i style="width:69.6%"></i></div></article>
